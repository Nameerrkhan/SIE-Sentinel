# Copy this to .env and fill in your key. .env is gitignored; this template is not.
SIE_API_KEY=sk-sie-REPLACE_ME
SIE_BASE_URL=https://api.superlinked.com

# --- models the scanner + MCP server use (all optional; defaults shown) ---
# SIE_ENCODE_MODEL=Qwen/Qwen3-Embedding-4B          # dense embeddings
# SIE_SPARSE_MODEL=prithivida/Splade_PP_en_v2       # sparse leg for hybrid search
# SIE_SCORE_MODEL=Qwen/Qwen3-Reranker-4B            # cross-encoder rerank
# SIE_EXTRACT_MODEL=fastino/gliner2-large-v1        # GLiNER structured extraction
# SIE_GUARD_MODEL=fastino/gliguard-LLMGuardrails-300M  # prompt-injection guardrail
# SIE_TRIAGE_MODEL=Qwen/Qwen3.5-4B                  # cheap high-recall triage
# SIE_ANALYST_MODEL=Qwen/Qwen3.8-27B-FP8            # deep analysis + validation

# --- tuning ---
# SIE_ENCODE_BATCH=64
# SIE_HTTP_TIMEOUT=180
# SIE_MAX_RETRIES=5
# SCAN_WORKERS=8            # concurrent LLM calls in the triage/analyze/validate stages

# Self-hosted SIE instead? Point at your box and pick locally-loaded models:
# SIE_BASE_URL=http://localhost:8080
